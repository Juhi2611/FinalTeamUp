rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Team presentation files — public read, authenticated write
    match /team-presentations/{teamId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 52428800  // 50 MB max
        && request.resource.contentType.matches('application/(pdf|vnd\\.ms-powerpoint|vnd\\.openxmlformats-officedocument\\.presentationml\\.presentation)');
      allow delete: if request.auth != null;
    }

    // Task proof files (already used by the app)
    match /task-proofs/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Default: authenticated users only
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
